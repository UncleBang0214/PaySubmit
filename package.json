    "@tauri-apps/cli": "2.11.0",
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.72.1",
