{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "支付提交工具",
  "version": "0.1.1",
  "identifier": "com.paysubmit.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "target/web"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "支付提交工具",
        "width": 1200,
        "height": 750,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "theme": "Light"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "SimpChinese"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
